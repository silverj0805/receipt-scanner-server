# Supabase Postgres. Connect > ORM > Prisma 탭에서 그대로 복사.
# 실제 비밀번호로 [YOUR-PASSWORD] 부분을 채운 뒤 .env 로 저장할 것 (.env는 git에 커밋 안 됨).

# 런타임 쿼리용 — transaction pooler(pgbouncer), src/libraries/db.ts의 PrismaPg adapter가 사용.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# `prisma migrate`/`generate` CLI 전용 — session pooler(비-pgbouncer), prisma7.config.ts가 사용.
# transaction pooler는 마이그레이션에 필요한 세션 기능(advisory lock 등)을 지원하지 않음.
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
